MYSQL_PORT=3307
MYSQL_DATABASE=iam
MYSQL_USER=iam
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# MFA 비밀값 암호화 키 (Base64 32바이트). 생성: openssl rand -base64 32
IAM_SECRET_KEY=
# 최초 관리자 계정 (처음 기동할 때만 필요. 로그인 후 비밀번호 변경·MFA 등록)
IAM_BOOTSTRAP_ADMIN_LOGIN=
IAM_BOOTSTRAP_ADMIN_PASSWORD=
# JWT 서명 키 (PKCS8 개인키·X509 공개키의 Base64 본문, 한 줄). 비우면 기동마다 새로 만든다 (운영 프로필은 필수)
# 생성: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem && openssl pkey -in private.pem -pubout -out public.pem
#       각 파일에서 ----- 줄을 빼고 한 줄로 붙인다
IAM_JWT_PRIVATE_KEY=
IAM_JWT_PUBLIC_KEY=
# 해외 IP 위험 신호용 MaxMind GeoLite2/GeoIP2 Country 파일(.mmdb) 경로. 비우면 국가를 판별하지 않는다
IAM_GEOIP_DATABASE=
# 관리 콘솔 주소. IAM 홈(내 계정)의 바로가기 링크에 쓴다. 비우면 http://localhost:3000
IAM_CONSOLE_URL=
